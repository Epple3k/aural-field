{
  "manifest_version": 3,
  "name": "Aural Field",
  "version": "1.0.0",
  "description": "A tiny generative ambient instrument that lives at the edge of your browser.",
  "permissions": ["sidePanel", "storage"],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open Aural Field"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}